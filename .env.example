# ===== Universal Web Scraper configuration =====
# Copy to .env and adjust. All values optional; config/default.yaml holds defaults.

# Storage (default: sqlite+aiosqlite:///data/scraper.db inside the repo)
DATABASE_URL=
# Redis for distributed rate limiting / queue (leave empty for in-process mode)
REDIS_URL=

# Proxies: one per line, or a path to a file with one URL per line.
# Format: http://user:pass@host:port  or  socks5://host:port
PROXY_LIST=
PROXY_LIST_FILE=

# CAPTCHA solving (off unless key provided)
CAPTCHA_PROVIDER=none            # none | twocaptcha
TWOCAPTCHA_API_KEY=

# LLM extraction (off unless key provided; any OpenAI-compatible endpoint works)
LLM_PROVIDER=none                # none | openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Politeness
RESPECT_ROBOTS=true

# Browser: tolerate broken/intercepted TLS certificates (corporate MITM proxies, some CDNs)
IGNORE_HTTPS_ERRORS=false
