# Universal Web Scraper — Celery worker (browser-capable)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libgbm1 libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 libxshmfence1 \
        fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-optional.txt ./
RUN pip install -r requirements.txt -r requirements-optional.txt \
    && python -m playwright install chromium

COPY . /app
RUN mkdir -p data

# browser queue: heavy jobs, one at a time per worker (see celery_app.py)
CMD ["celery", "-A", "src.queue.celery_app.celery_app", "worker", \
     "-Q", "standard,lightweight,browser", "--concurrency=2", "-l", "info"]
